      "link": null,
      "locked": false,
      "text": "score = breakdown.score\n    if score >=\nauto_resolve_threshold:\n        route =\nRoute.AUTO_RESOLVE\n    elif score >=\ndeep_reason_threshold:\n        route =\nRoute.DEEP_REASON\n    elif score >=\nawaiting_approval_threshold:\n        route =\nRoute.AWAITING_APPROVAL\n    else:\n        route =\nRoute.ESCALATED",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "ZqernjKEwAW-9jofXCDvz",
      "originalText": "score = breakdown.score\n    if score >= auto_resolve_threshold:\n        route = Route.AUTO_RESOLVE\n    elif score >= deep_reason_threshold:\n        route = Route.DEEP_REASON\n    elif score >= awaiting_approval_threshold:\n        route = Route.AWAITING_APPROVAL\n    else:\n        route = Route.ESCALATED",
      "autoResize": true,
      "lineHeight": 1.25
    },
