      "link": null,
      "locked": false,
      "text": "todo_id: str\n    todo_type: str          # e.g. \"D1-BSEG\",\nmaps to one of the 11 agent types\n    sa_id: str\n    account_id: str\n    error_code: str\n    priority: str = \"MEDIUM\"\n    age_days: int = 0\n    status: ToDoStatus =\nToDoStatus.PENDING\n    idempotency_key: str =\nfield(default_factory=lambda: uuid.uuid4().hex)\n    raw: dict[str, Any] =\nfield(default_factory=dict)",
      "fontSize": 19.120209126290682,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "todo_id: str\n    todo_type: str          # e.g. \"D1-BSEG\", maps to one of the 11 agent types\n    sa_id: str\n    account_id: str\n    error_code: str\n    priority: str = \"MEDIUM\"\n    age_days: int = 0\n    status: ToDoStatus = ToDoStatus.PENDING\n    idempotency_key: str = field(default_factory=lambda: uuid.uuid4().hex)\n    raw: dict[str, Any] = field(default_factory=dict)",
      "autoResize": false,
      "lineHeight": 1.25
    },
